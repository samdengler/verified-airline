{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "verified-airline": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "va",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/fira-sans/400.css",
              "node_modules/@fontsource/fira-sans/500.css",
              "node_modules/@fontsource/fira-sans/600.css",
              "node_modules/@fontsource/fira-sans/700.css",
              "node_modules/@fontsource/dm-serif-display/400.css",
              "node_modules/@fontsource/jetbrains-mono/400.css",
              "node_modules/@fontsource/jetbrains-mono/500.css",
              "node_modules/@fontsource/jetbrains-mono/700.css",
              "src/styles.css",
              "src/chat.css",
              "src/one-id.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "allowedCommonJsDependencies": [
              "amazon-connect-chatjs"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "verified-airline:build:production"
            },
            "development": {
              "buildTarget": "verified-airline:build:development",
              "proxyConfig": "proxy.conf.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
